{
  "name": "study-abroad-platform",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "./dev.sh",
    "dev:docker": "./dev-docker.sh",
    "docker:backend": "docker compose up -d --build db redis api",
    "docker:backend:logs": "docker compose logs -f api",
    "api": "pnpm --filter api dev",
    "web": "pnpm --filter web dev",
    "web:turbopack": "pnpm --filter web dev:turbopack",
    "web:remote": "NEXT_PUBLIC_API_URL=https://study-abroad-api-1032896108391.us-central1.run.app pnpm --filter web dev",
    "mobile": "pnpm --filter study-abroad-mobile start",
    "mobile:ios": "pnpm --filter study-abroad-mobile ios:device",
    "mobile:android": "pnpm --filter study-abroad-mobile android:device",
    "mobile:build:ios": "pnpm --filter study-abroad-mobile ios:build",
    "mobile:build:android": "pnpm --filter study-abroad-mobile android:build",
    "docker:up": "docker compose up -d db redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f db redis",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:web": "playwright test e2e/core-pages.spec.ts",
    "test:e2e:web:full-ui": "playwright test e2e/full-ui-surface.spec.ts",
    "test:e2e:web:full-ui:update": "FULL_UI_VISUAL_DIFF=1 playwright test e2e/full-ui-surface.spec.ts --update-snapshots",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "prepare": "husky",
    "sbom:generate": "cdxgen -o sbom/bom.json --deep -t js --spec-version 1.5",
    "sbom:verify": "node -e \"const s=require('./sbom/bom.json'); if(!s.specVersion||!(s.components||[]).length){process.exit(1)} console.log('SBOM OK — specVersion:', s.specVersion, '| components:', s.components.length);\"",
    "lint:routes": "tsx scripts/check-api-routes.ts",
    "lint:integration": "tsx scripts/check-integration.ts",
    "lint:recurrence": "tsx scripts/check-recurrence.ts",
    "quality:icons": "tsx scripts/check-icon-language.ts",
    "release-gate:generate": "tsx scripts/release-gate/generate-release-gate.ts",
    "release-gate:run": "tsx scripts/runtime-release-gate.ts",
    "full-surface:generate": "tsx scripts/release-gate/generate-full-surface-audit.ts",
    "full-surface:run": "tsx scripts/runtime-full-surface-audit.ts",
    "full-surface:batch": "tsx scripts/run-full-surface-batch.ts",
    "prediction:accuracy": "tsx scripts/prediction-accuracy-report.ts",
    "prediction:smoke": "tsx scripts/prediction-stability-smoke.ts",
    "prediction:gate": "tsx scripts/prediction-gate.ts",
    "prediction:audit": "tsx scripts/prediction-system-audit.ts",
    "application-analysis:governance": "tsx scripts/application-analysis-governance.ts",
    "school-facts:verify": "pnpm --filter api verify:school-facts",
    "system:accuracy-audit": "tsx scripts/audit/run-system-accuracy-audit.ts",
    "lint:drift": "tsx scripts/check-drift.ts",
    "lint:journeys": "tsx scripts/check-journey-paths.ts",
    "lint:bundle": "tsx scripts/check-bundle-size.ts",
    "lint:release-runtime": "tsx scripts/check-release-runtime.ts",
    "lint:coverage-ratchet": "tsx scripts/check-coverage-ratchet.ts",
    "lint:audit-gate": "tsx scripts/check-audit-gate.ts",
    "lint:dep-pins": "tsx scripts/check-dep-pins.ts",
    "lint:deploy-drift": "tsx scripts/check-deploy-config-drift.ts",
    "lint:seed-parity": "tsx scripts/check-seed-pipeline-parity.ts",
    "snapshot": "tsx scripts/generate-repo-snapshot.ts",
    "churn:report": "tsx scripts/churn-report.ts",
    "git:dashboard": "tsx scripts/git-dashboard.ts",
    "lint:dead-code": "knip",
    "lint:all": "pnpm lint && pnpm --filter web lint:quality && pnpm --filter web lint:typography && pnpm --filter api lint:quality && pnpm --filter study-abroad-mobile lint:quality && pnpm --filter web lint:i18n && pnpm --filter study-abroad-mobile lint:i18n && pnpm lint:routes && pnpm lint:integration && pnpm lint:drift && pnpm lint:journeys && pnpm lint:coverage-ratchet && pnpm lint:audit-gate && pnpm lint:dep-pins && pnpm lint:deploy-drift && pnpm lint:seed-parity && pnpm format:check",
    "check": "pnpm lint:all && pnpm test",
    "preflight": "pnpm --filter api db:generate && pnpm lint:all && pnpm test",
    "prepush": "pnpm --filter api db:generate && pnpm --filter api exec tsc --noEmit --project tsconfig.build.json && pnpm --filter web exec tsc --noEmit && pnpm --filter study-abroad-mobile exec tsc --noEmit && pnpm test",
    "verify:full-platform": "tsx scripts/verify-full-platform.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@cyclonedx/cdxgen": "^11.3.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --quiet"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "20.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "sharp"
    ],
    "overrides": {
      "form-data": ">=4.0.6",
      "lodash": "4.18.1",
      "qs": ">=6.14.1",
      "tar": ">=7.5.10",
      "@xhmikosr/decompress": ">=11.1.3",
      "multer": ">=2.2.0",
      "hono": ">=4.12.25",
      "piscina": ">=4.9.3",
      "@xmldom/xmldom": ">=0.9.10",
      "@expo/plist>@xmldom/xmldom": "0.8.13",
      "fast-xml-parser": ">=5.5.6",
      "minimatch@^3": ">=3.1.4 <4",
      "minimatch@^5": ">=5.1.8 <6",
      "minimatch@^9": ">=9.0.7 <10",
      "minimatch@^10": ">=10.2.3",
      "serialize-javascript": ">=7.0.3",
      "@isaacs/brace-expansion": ">=5.0.1",
      "basic-ftp": ">=5.3.0",
      "protobufjs": ">=7.6.1 <8",
      "rollup": ">=4.59.0",
      "glob@>=11.0.0 <11.1.0": ">=11.1.0",
      "jws@4.0.0": ">=4.0.1",
      "knip>zod": "^4.1.11",
      "sequelize@>=6.0.0 <=6.37.7": ">=6.37.8 <7",
      "flatted@<=3.4.1": ">=3.4.2",
      "undici@>=5.0.0 <6.27.0": ">=6.27.0 <7",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0 <8",
      "socket.io-parser@>=4.0.0 <4.2.6": ">=4.2.6",
      "picomatch@^2": ">=2.3.2 <3",
      "picomatch@^3": ">=3.0.2 <4",
      "picomatch@^4": ">=4.0.4",
      "node-forge": ">=1.4.0",
      "handlebars": ">=4.7.9",
      "linkify-it": ">=5.0.1",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "vite@>=7.0.0 <7.3.2": ">=7.3.2",
      "next@>=16.0.0-beta.0 <16.2.6": ">=16.2.6",
      "fast-uri": ">=3.1.2",
      "fast-xml-builder": ">=1.1.7",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "zod": "3.25.76",
      "shell-quote": ">=1.8.4",
      "@grpc/grpc-js": ">=1.14.4",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "ws@>=6.0.0 <6.2.4": ">=6.2.4",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "jsonata": ">=2.2.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fx2h-pf6j-xcff"
      ]
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@sentry/nestjs": "^10.34.0",
    "@sentry/nextjs": "^10.34.0",
    "@sentry/node": "^10.34.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.27.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  }
}
