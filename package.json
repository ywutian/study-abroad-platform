{
  "name": "study-abroad-platform",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "./dev.sh",
    "api": "pnpm --filter api dev",
    "web": "pnpm --filter web dev",
    "web:remote": "NEXT_PUBLIC_API_URL=https://study-abroad-api-1032896108391.us-central1.run.app pnpm --filter web dev",
    "mobile": "pnpm --filter study-abroad-mobile start",
    "mobile:ios": "pnpm --filter study-abroad-mobile ios:device",
    "mobile:android": "pnpm --filter study-abroad-mobile android:device",
    "mobile:build:ios": "pnpm --filter study-abroad-mobile ios:build",
    "mobile:build:android": "pnpm --filter study-abroad-mobile android:build",
    "docker:up": "docker-compose up -d db redis",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f db redis",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:web": "playwright test e2e/core-pages.spec.ts",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "prepare": "husky",
    "sbom:generate": "cdxgen -o sbom/bom.json --deep -t js --spec-version 1.5",
    "sbom:verify": "node -e \"const s=require('./sbom/bom.json'); if(!s.specVersion||!(s.components||[]).length){process.exit(1)} console.log('SBOM OK — specVersion:', s.specVersion, '| components:', s.components.length);\"",
    "lint:all": "pnpm lint && pnpm --filter web lint:quality && pnpm --filter api lint:quality && pnpm --filter web lint:i18n",
    "check": "pnpm lint:all && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@cyclonedx/cdxgen": "^11.3.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --quiet"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "sharp"
    ],
    "overrides": {
      "form-data": ">=4.0.0",
      "qs": ">=6.14.1",
      "tar": ">=7.5.10",
      "multer": ">=2.1.1",
      "fast-xml-parser": ">=5.3.6",
      "minimatch@^3": ">=3.1.4 <4",
      "minimatch@^5": ">=5.1.8 <6",
      "minimatch@^9": ">=9.0.7 <10",
      "minimatch@^10": ">=10.2.3",
      "serialize-javascript": ">=7.0.3",
      "@isaacs/brace-expansion": ">=5.0.1",
      "basic-ftp": ">=5.2.0",
      "rollup": ">=4.59.0"
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@sentry/nestjs": "^10.34.0",
    "@sentry/nextjs": "^10.34.0",
    "@sentry/node": "^10.34.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.27.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  }
}
