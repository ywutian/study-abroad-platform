{
  "name": "study-abroad-platform",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "./dev.sh",
    "api": "pnpm --filter api dev",
    "web": "pnpm --filter web dev",
    "web:turbopack": "pnpm --filter web dev:turbopack",
    "web:remote": "NEXT_PUBLIC_API_URL=https://study-abroad-api-1032896108391.us-central1.run.app pnpm --filter web dev",
    "mobile": "pnpm --filter study-abroad-mobile start",
    "mobile:ios": "pnpm --filter study-abroad-mobile ios:device",
    "mobile:android": "pnpm --filter study-abroad-mobile android:device",
    "mobile:build:ios": "pnpm --filter study-abroad-mobile ios:build",
    "mobile:build:android": "pnpm --filter study-abroad-mobile android:build",
    "docker:up": "docker-compose up -d db redis",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f db redis",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:web": "playwright test e2e/core-pages.spec.ts",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "prepare": "husky",
    "sbom:generate": "cdxgen -o sbom/bom.json --deep -t js --spec-version 1.5",
    "sbom:verify": "node -e \"const s=require('./sbom/bom.json'); if(!s.specVersion||!(s.components||[]).length){process.exit(1)} console.log('SBOM OK — specVersion:', s.specVersion, '| components:', s.components.length);\"",
    "lint:routes": "tsx scripts/check-api-routes.ts",
    "lint:integration": "tsx scripts/check-integration.ts",
    "release-gate:generate": "tsx scripts/release-gate/generate-release-gate.ts",
    "release-gate:run": "tsx scripts/runtime-release-gate.ts",
    "full-surface:generate": "tsx scripts/release-gate/generate-full-surface-audit.ts",
    "full-surface:run": "tsx scripts/runtime-full-surface-audit.ts",
    "full-surface:batch": "tsx scripts/run-full-surface-batch.ts",
    "prediction-v5-review:init": "tsx scripts/prediction-v5-review.ts init",
    "prediction-v5-review:validate": "tsx scripts/prediction-v5-review.ts validate",
    "prediction-v5-review:refresh": "tsx scripts/prediction-v5-review.ts refresh-summary",
    "prediction-v5-review:create-issue": "tsx scripts/prediction-v5-review.ts create-issue",
    "prediction:accuracy": "tsx scripts/prediction-accuracy-report.ts",
    "prediction:smoke": "tsx scripts/prediction-stability-smoke.ts",
    "prediction:gate": "tsx scripts/prediction-gate.ts",
    "lint:drift": "tsx scripts/check-drift.ts",
    "lint:dead-code": "knip",
    "lint:all": "pnpm lint && pnpm --filter web lint:quality && pnpm --filter api lint:quality && pnpm --filter web lint:i18n && pnpm lint:routes && pnpm lint:integration && pnpm lint:drift",
    "check": "pnpm lint:all && pnpm test",
    "prepush": "pnpm --filter api db:generate && pnpm --filter api exec tsc --noEmit --project tsconfig.build.json && pnpm --filter web exec tsc --noEmit && pnpm --filter mobile exec tsc --noEmit && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@cyclonedx/cdxgen": "^11.3.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^6.0.5",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --quiet"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "sharp"
    ],
    "overrides": {
      "form-data": ">=4.0.0",
      "lodash": "4.18.1",
      "qs": ">=6.14.1",
      "tar": ">=7.5.10",
      "multer": ">=2.1.1",
      "@xmldom/xmldom": "0.8.12",
      "fast-xml-parser": ">=5.5.6",
      "minimatch@^3": ">=3.1.4 <4",
      "minimatch@^5": ">=5.1.8 <6",
      "minimatch@^9": ">=9.0.7 <10",
      "minimatch@^10": ">=10.2.3",
      "serialize-javascript": ">=7.0.3",
      "@isaacs/brace-expansion": ">=5.0.1",
      "basic-ftp": ">=5.2.2",
      "rollup": ">=4.59.0",
      "glob@>=11.0.0 <11.1.0": ">=11.1.0",
      "jws@4.0.0": ">=4.0.1",
      "sequelize@>=6.0.0 <=6.37.7": ">=6.37.8 <7",
      "flatted@<=3.4.1": ">=3.4.2",
      "undici@>=5.0.0 <6.24.0": ">=6.24.0 <7",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0 <8",
      "socket.io-parser@>=4.0.0 <4.2.6": ">=4.2.6",
      "picomatch@^2": ">=2.3.2 <3",
      "picomatch@^3": ">=3.0.2 <4",
      "picomatch@^4": ">=4.0.4",
      "node-forge": ">=1.4.0",
      "handlebars": ">=4.7.9",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "vite@>=7.0.0 <7.3.2": ">=7.3.2",
      "next@>=16.0.0-beta.0 <16.2.3": ">=16.2.3"
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@sentry/nestjs": "^10.34.0",
    "@sentry/nextjs": "^10.34.0",
    "@sentry/node": "^10.34.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.27.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  }
}
