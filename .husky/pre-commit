pnpm exec lint-staged

# ── Secret scanning (if gitleaks installed) ───────────────
if command -v gitleaks &> /dev/null; then
  echo ""
  echo "🔐 Running secret scan..."
  if ! gitleaks protect --staged --no-banner; then
    echo ""
    echo "❌ Secret scan failed: potential secrets detected in staged files."
    echo "   Review the findings above and remove any secrets before committing."
    echo ""
    exit 1
  fi
fi

# ── i18n 自动校验 ──────────────────────────────────────────
# 当 web 应用的源码或翻译文件有变动时，自动运行 i18n 检查
STAGED_FILES=$(git diff --cached --name-only)

# 检查是否有 apps/web 的源码或翻译文件变动
WEB_SRC_CHANGED=$(echo "$STAGED_FILES" | grep -c "^apps/web/src/" || true)

if [ "$WEB_SRC_CHANGED" -gt "0" ]; then
  echo ""
  echo "🌐 Running i18n checks (source or translation files changed)..."
  echo ""

  # 1. 检查源码中使用的 key 是否在 zh.json 中存在
  if ! pnpm --filter web exec tsx scripts/check-missing-keys.ts; then
    echo ""
    echo "❌ i18n check failed: missing translation keys detected."
    echo "   Run 'pnpm --filter web exec tsx scripts/check-missing-keys.ts --fix'"
    echo "   to auto-generate placeholder translations, then replace [TODO] values."
    echo ""
    exit 1
  fi

  # 2. 检查 zh.json 和 en.json 的 key 一致性
  if ! pnpm --filter web exec tsx scripts/check-translation-keys.ts; then
    echo ""
    echo "❌ i18n check failed: zh.json and en.json keys are inconsistent."
    echo ""
    exit 1
  fi

  # 3. 检查翻译值的语言是否正确
  if ! pnpm --filter web exec tsx scripts/check-wrong-language.ts; then
    echo ""
    echo "❌ i18n check failed: wrong-language translations detected."
    echo ""
    exit 1
  fi

  echo ""
  echo "✅ i18n checks passed!"
  echo ""
fi

# ── Code quality checks ─────────────────────────────────────
# Check for dynamic Tailwind classes, hardcoded slate colors, console.log, etc.
if [ "$WEB_SRC_CHANGED" -gt "0" ]; then
  echo ""
  echo "🔍 Running code quality checks..."
  echo ""

  if ! pnpm --filter web exec tsx scripts/check-code-quality.ts --staged; then
    echo ""
    echo "❌ Code quality check failed. See issues above."
    echo ""
    exit 1
  fi
fi

# ── API quality checks ──────────────────────────────────────
# Check for inline @Body types, unthrottled AI endpoints, generic throws
API_SRC_CHANGED=$(echo "$STAGED_FILES" | grep -c "^apps/api/src/" || true)

if [ "$API_SRC_CHANGED" -gt "0" ]; then
  echo ""
  echo "🔍 Running API quality checks..."
  echo ""

  if ! pnpm --filter api exec tsx scripts/check-api-quality.ts --staged; then
    echo ""
    echo "❌ API quality check failed. See issues above."
    echo ""
    exit 1
  fi
fi

# ── Mobile quality + i18n checks ───────────────────────────
# Check for hardcoded colors, dynamic styles, console.log, i18n consistency
MOBILE_SRC_CHANGED=$(echo "$STAGED_FILES" | grep -c "^apps/mobile/src/" || true)

if [ "$MOBILE_SRC_CHANGED" -gt "0" ]; then
  echo ""
  echo "📱 Running mobile quality checks..."
  echo ""

  if ! pnpm --filter study-abroad-mobile exec tsx scripts/check-mobile-quality.ts --staged; then
    echo ""
    echo "❌ Mobile quality check failed. See issues above."
    echo ""
    exit 1
  fi

  echo ""
  echo "🌐 Running mobile i18n checks..."
  echo ""

  if ! pnpm --filter study-abroad-mobile exec tsx scripts/check-mobile-i18n.ts; then
    echo ""
    echo "❌ Mobile i18n check failed. See issues above."
    echo ""
    exit 1
  fi
fi
