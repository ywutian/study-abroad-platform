#!/usr/bin/env sh

# Ensure we're in the repo root
cd "$(git rev-parse --show-toplevel)" || exit 1

echo ""
echo "🚀 Running pre-push checks..."
echo ""

# Step 0: Lockfile drift — the asymmetry that makes "passes locally, fails on
# Vercel/CI" possible. `--frozen-lockfile` is pnpm's default in CI but NOT
# locally, so a local `pnpm install` can silently mutate pnpm-lock.yaml. Verify
# it here the same way CI and Vercel do. See docs/ANTI_CHURN_PLAYBOOK.md.
echo "🔒 Verifying lockfile is in sync (frozen-lockfile)..."
if ! pnpm install --frozen-lockfile --ignore-scripts > /dev/null 2>&1; then
  echo "❌ Lockfile out of sync with package.json (ERR_PNPM_OUTDATED_LOCKFILE)."
  echo "   Run \`pnpm install\`, commit the updated pnpm-lock.yaml, then push."
  exit 1
fi

# Step 1: Generate Prisma client (needed for type resolution)
echo "📦 Generating Prisma client..."
pnpm --filter api db:generate || exit 1

# Step 2: Smart verification gate (only affected apps)
# Pre-push mode compares committed changes vs upstream — matches what CI sees.
# Runs typecheck + lint (eslint) + lint:routes/i18n/integration/drift, scoped
# to affected apps. Fast-push: the unit-test suite runs in CI (ci.yml), NOT on
# every push, so `git push` stays fast; tests still gate the PR.
echo ""
pnpm exec tsx scripts/verify-gate.ts --pre-push --no-test --verbose || exit 1

# Step 2.5: Root guardrails (fast, global — coverage ratchet / audit gate / deploy drift)
echo ""
echo "🛡️  Checking root guardrails..."
pnpm lint:coverage-ratchet || exit 1
pnpm lint:audit-gate || exit 1
pnpm lint:dep-pins || exit 1
pnpm lint:deploy-drift || exit 1
pnpm lint:seed-parity || exit 1

# Step 3: Migration safety check (only if migration files changed)
CHANGED=$(git diff --name-only origin/main...HEAD 2>/dev/null || git diff --name-only HEAD~1)
if echo "$CHANGED" | grep -q "prisma/migrations/"; then
  echo ""
  echo "🔍 Checking migration safety..."
  pnpm exec tsx scripts/check-migration-safety.ts --new-only || exit 1
fi

# Step 4: Dependency audit (~3s)
echo ""
echo "🔍 Running dependency audit..."
pnpm audit --audit-level=high --registry=https://registry.npmjs.org || exit 1

echo ""
echo "✅ Pre-push checks passed!"
