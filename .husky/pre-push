#!/usr/bin/env sh

# Ensure we're in the repo root
cd "$(git rev-parse --show-toplevel)" || exit 1

echo ""
echo "🚀 Running pre-push checks..."
echo ""

# Step 1: Generate Prisma client (needed for type resolution)
echo "📦 Generating Prisma client..."
pnpm --filter api db:generate || exit 1

# Step 2: Smart verification gate (only affected apps)
# Pre-push mode compares committed changes vs upstream — matches what
# CI will see. Runs: typecheck, lint (eslint), test, lint:routes,
# lint:i18n, lint:integration, lint:drift — scoped to affected apps.
echo ""
pnpm exec tsx scripts/verify-gate.ts --pre-push --verbose || exit 1

# Step 2.5: Root guardrails (fast, global — coverage ratchet / audit gate / deploy drift)
echo ""
echo "🛡️  Checking root guardrails..."
pnpm lint:coverage-ratchet || exit 1
pnpm lint:audit-gate || exit 1
pnpm lint:deploy-drift || exit 1
pnpm lint:seed-parity || exit 1

# Step 3: Migration safety check (only if migration files changed)
CHANGED=$(git diff --name-only origin/main...HEAD 2>/dev/null || git diff --name-only HEAD~1)
if echo "$CHANGED" | grep -q "prisma/migrations/"; then
  echo ""
  echo "🔍 Checking migration safety..."
  pnpm exec tsx scripts/check-migration-safety.ts --new-only || exit 1
fi

# Step 4: Dependency audit (~3s)
echo ""
echo "🔍 Running dependency audit..."
pnpm audit --audit-level=high --registry=https://registry.npmjs.org || exit 1

echo ""
echo "✅ Pre-push checks passed!"
