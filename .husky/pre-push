#!/usr/bin/env sh

# Ensure we're in the repo root
cd "$(git rev-parse --show-toplevel)" || exit 1

echo ""
echo "🚀 Running pre-push checks..."
echo ""

# Step 1: Generate Prisma client (needed for type resolution)
echo "📦 Generating Prisma client..."
pnpm --filter api db:generate || exit 1

# Step 2: Smart verification gate (only affected apps)
# Runs typecheck, tests, lint:routes, lint:i18n — scoped to changed files
echo ""
pnpm exec tsx scripts/verify-gate.ts --verbose || exit 1

echo ""
echo "✅ Pre-push checks passed!"
