model BenchmarkProfile {
  id          String                 @id @default(cuid())
  label       String
  cohortTag   String?
  profileJson Json
  runs        CompetitorRun[]
  predictions CompetitorPrediction[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([createdAt])
  @@index([cohortTag, label])
}

model CompetitorSource {
  id                         String                  @id @default(cuid())
  key                        String                  @unique
  label                      String
  baseUrl                    String
  enabled                    Boolean                 @default(true)
  supportsNumericProbability Boolean                 @default(true)
  runs                       CompetitorRun[]
  predictions                CompetitorPrediction[]
  staticTeacherSnapshots     StaticTeacherSnapshot[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([enabled])
}

model CompetitorRun {
  id           String                 @id @default(cuid())
  profileId    String
  sourceId     String
  profile      BenchmarkProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source       CompetitorSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status       CompetitorRunStatus    @default(PENDING)
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  successCount Int                    @default(0)
  errorCount   Int                    @default(0)
  note         String?
  predictions  CompetitorPrediction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([profileId, sourceId])
  @@index([status])
}

model CompetitorPrediction {
  id            String                     @id @default(cuid())
  runId         String
  profileId     String
  sourceId      String
  run           CompetitorRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  profile       BenchmarkProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source        CompetitorSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  schoolKey     String
  rawSchoolName String
  schoolId      String?
  school        School?                    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  matchType     String?
  probability   Decimal?                   @db.Decimal(5, 4)
  tierLabel     String?
  rawPayload    Json
  status        CompetitorPredictionStatus @default(PENDING)
  errorMsg      String?
  fetchedAt     DateTime                   @default(now())
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@unique([runId, schoolKey])
  @@index([profileId, sourceId])
  @@index([schoolId])
  @@index([status])
}

model StaticTeacherSnapshot {
  id         String                      @id @default(cuid())
  sourceId   String
  schoolId   String
  source     CompetitorSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  school     School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug       String?
  lookupJson Json
  status     StaticTeacherSnapshotStatus @default(PENDING)
  errorMsg   String?
  fetchedAt  DateTime                    @default(now())
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@unique([sourceId, schoolId])
  @@index([status])
  @@index([sourceId, fetchedAt])
}

model DistillationDailyAggregate {
  id                    String   @id @default(cuid())
  date                  DateTime @db.Date
  stage                 String
  teacherKey            String
  cohortKey             String
  selectivityBand       String?
  predictionCount       Int      @default(0)
  activeSignalCount     Int      @default(0)
  resolvedOutcomeCount  Int      @default(0)
  avgTeacherProbability Decimal? @db.Decimal(6, 4)
  avgObservedWeight     Decimal? @db.Decimal(6, 4)
  avgBlendDelta         Decimal? @db.Decimal(6, 4)
  avgAbsBlendDelta      Decimal? @db.Decimal(6, 4)
  brierTeacher          Decimal? @db.Decimal(8, 6)
  brierBlended          Decimal? @db.Decimal(8, 6)
  brierServed           Decimal? @db.Decimal(8, 6)
  distinctSchoolCount   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date, stage, teacherKey, cohortKey, selectivityBand])
  @@index([date, stage])
  @@index([teacherKey, date])
  @@index([cohortKey, date])
}

model DistillationSchoolDailyAggregate {
  id                   String                   @id @default(cuid())
  date                 DateTime                 @db.Date
  schoolId             String
  school               School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cohortKey            String
  stage                String
  predictionCount      Int                      @default(0)
  resolvedOutcomeCount Int                      @default(0)
  coverageTier         DistillationCoverageTier @default(NONE)
  activeTeacherKeys    String[]
  avgBlendDelta        Decimal?                 @db.Decimal(6, 4)
  avgAbsBlendDelta     Decimal?                 @db.Decimal(6, 4)
  brierBlended         Decimal?                 @db.Decimal(8, 6)
  brierServed          Decimal?                 @db.Decimal(8, 6)
  lastObservedAt       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([date, schoolId, cohortKey, stage])
  @@index([date, stage])
  @@index([schoolId, date])
  @@index([cohortKey, date])
}

model PredictionModel {
  id              String  @id @default(cuid())
  version         Int     @unique
  tier            Int // 1=Platt, 2=LR-basic, 3=LR-full, 4=GBDT
  modelType       String // 'platt' | 'logistic_regression' | 'gbdt'
  weights         Json // TrainedModel or GBDTModel serialized
  config          Json // training hyperparameters
  medians         Json // feature medians for imputation
  selectivityBand String? // null=global, "0.0-0.3", "0.3-0.6", "0.6-0.8", "0.8-1.0"

  // Evaluation metrics
  trainSamples   Int
  valSamples     Int
  trainAuc       Float
  valAuc         Float
  brierScore     Float
  calibrationECE Float
  cvMeanAuc      Float?
  cvStdAuc       Float?

  // Lifecycle
  status        ModelStatus @default(CANDIDATE)
  promotedAt    DateTime?
  retiredAt     DateTime?
  shadowMetrics Json? // online A/B metrics accumulated during shadow

  // Fairness
  fairnessMetrics     Json? // { demographicParity, equalizedOdds, bandFairness }
  predictionResults   PredictionResult[]
  predictionSnapshots PredictionSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tier, selectivityBand])
}

// ── Feature Flags ────────────────────────────────────────
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rules       Json?    @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

/// Embedding vectors for semantic agent routing (pgvector).
/// Each row stores one example query for an agent type.
model AgentRouteEmbedding {
  id        String                      @id @default(uuid())
  agentType String                      @map("agent_type")
  example   String /// Example query text
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")

  @@index([agentType])
  @@map("agent_route_embeddings")
}

/// Graph entity for relationship-based memory (schools, majors, deadlines).
model GraphEntity {
  id         String   @id @default(cuid())
  userId     String
  entityType String /// school, major, program, deadline, activity
  name       String
  attributes Json? /// flexible metadata (rank, acceptanceRate, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outEdges EntityRelationship[] @relation("source")
  inEdges  EntityRelationship[] @relation("target")

  @@unique([userId, entityType, name])
  @@index([userId, entityType])
  @@map("graph_entities")
}

/// Directed edge between two graph entities.
model EntityRelationship {
  id             String   @id @default(cuid())
  userId         String
  sourceEntityId String
  targetEntityId String
  relationType   String /// applied_to, has_major, similar_to, has_deadline
  weight         Float    @default(1.0)
  metadata       Json?
  createdAt      DateTime @default(now())

  sourceEntity GraphEntity @relation("source", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity GraphEntity @relation("target", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([userId, sourceEntityId])
  @@index([userId, relationType])
  @@map("entity_relationships")
}
