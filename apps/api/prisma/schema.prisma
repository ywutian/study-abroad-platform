model ResumeSection {
  id        String            @id @default(cuid())
  resumeId  String
  resume    Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  type      ResumeSectionType
  title     String
  content   Json
  isVisible Boolean           @default(true)
  order     Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
}

model ResumeSnapshot {
  id          String  @id @default(cuid())
  resumeId    String
  resume      Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version     Int
  data        Json
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
}

model ResumeAIReview {
  id           String @id @default(cuid())
  resumeId     String
  resume       Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  type         String
  input        Json
  output       Json
  overallScore Int?
  tokenUsed    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
}

