generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum Role {
  USER
  VERIFIED
  OPERATOR // 数据录入/审核（实习生）
  ADMIN // 管理员
  SUPER_ADMIN // 超级管理员（全权）
}

// ============================================
// Data Enrichment — Review & Staging
// ============================================

