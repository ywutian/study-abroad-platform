// ============================================
// Resume System (简历系统)
// ============================================

model Resume {
  id                        String                         @id @default(cuid())
  userId                    String
  user                      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                     String                         @default("My Resume")
  status                    ResumeStatus                   @default(DRAFT)
  type                      ResumeType                     @default(COLLEGE_APPLICATION)
  templateId                String                         @default("jake-classic")
  language                  String                         @default("en")
  settings                  Json                           @default("{}")
  targetContext             Json                           @default("{}")
  sections                  ResumeSection[]
  snapshots                 ResumeSnapshot[]
  aiReviews                 ResumeAIReview[]
  teamApplications          TeamApplication[]              @relation("TeamApplicationResume")
  recruitmentMemberProfiles TeamRecruitmentMemberProfile[] @relation("RecruitmentSelectedResume")
  version                   Int                            @default(1)
  lastImportedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
