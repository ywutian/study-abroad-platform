/// Declares which writer produced a prediction row so downstream consumers
/// can filter correctly and writers never accidentally clobber each other.
/// - AUTHORITATIVE: full pipeline (PredictionService / ML / Scorecard served path)
/// - PREVIEW: UI-facing quick estimate (SchoolListService.syncQuickMatchToPrediction)
/// Invariant: PREVIEW must never overwrite an AUTHORITATIVE row. Enforced in
/// application (school-list.service.ts) and by check-integration lint rule
/// `prediction-write-must-declare-authority`.
enum PredictionAuthority {
  AUTHORITATIVE
  PREVIEW
}

enum PredictionOutcomeLabel {
  ADMITTED
  REJECTED
  WAITLISTED
  DEFERRED
  WITHDRAWN
  UNKNOWN
  CENSORED
}

enum PredictionFeedbackSentiment {
  POSITIVE
  UNSURE
  NEGATIVE
}

enum PredictionFeedbackCategory {
  TOO_HIGH
  TOO_LOW
  FACTORS_WRONG
  NEVER_MOVES
  OTHER
}

enum TaskType {
  ESSAY
  DOCUMENT
  TEST
  INTERVIEW
  RECOMMENDATION
  OTHER
}

enum ApplicationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

