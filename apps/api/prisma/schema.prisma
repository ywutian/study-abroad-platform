// ============================================
// User & Auth
// ============================================

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  role                 Role      @default(USER)
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?
  emailVerifyTokenExp  DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  locale               String    @default("zh")

  // Relations
  profile                   Profile?
  refreshTokens             RefreshToken[]
  followers                 Follow[]                       @relation("Following")
  following                 Follow[]                       @relation("Followers")
  blockedUsers              Block[]                        @relation("Blocker")
  blockedBy                 Block[]                        @relation("Blocked")
  sentMessages              Message[]
  conversations             ConversationParticipant[]
  recruitmentMemberProfiles TeamRecruitmentMemberProfile[]
  recruitmentSwipesActed    TeamRecruitmentSwipe[]
  customRankings            CustomRanking[]
  reviewsGiven              Review[]                       @relation("Reviewer")
  reviewsReceived           Review[]                       @relation("ReviewedProfile")
  reviewReactions           ReviewReaction[]
  reports                   Report[]
  assignedReports           Report[]                       @relation("ReportAssignee")
  admissionCases            AdmissionCase[]
  userLists                 UserList[]
  userListVotes             UserListVote[]
  schoolListItems           SchoolListItem[]

  // Forum relations
  forumPosts              ForumPost[]
  forumComments           ForumComment[]
  createdForumCommunities ForumCommunity[]       @relation("ForumCommunityCreator")
  forumCommunityFollows   ForumCommunityFollow[]
  teamMemberships         TeamMember[]
  teamApplicationsApplied TeamApplication[]

  // Standalone 组队 (first-class teams)
  createdTeams                 Team[]               @relation("TeamCreator")
  standaloneTeamMemberships    TeamMembership[]     @relation("StandaloneTeamMember")
  teamInvitationsSent          TeamInvitation[]     @relation("TeamInvitationSent")
  teamInvitationsReceived      TeamInvitation[]     @relation("TeamInvitationReceived")
  communityRecruitmentContexts RecruitmentContext[] @relation("CommunityRecruitmentContextCreator")

  // Swipe game
  points       Int            @default(0)
  swipeStats   SwipeStats?
  pointHistory PointHistory[]
  payments     Payment[]

  // Peer review system (互评)
  peerReviewsGiven    PeerReview[] @relation("ReviewsGiven")
  peerReviewsReceived PeerReview[] @relation("ReviewsReceived")
  avgRating           Float? // 平均评分 (缓存)
  reviewCount         Int          @default(0) // 评价数

  // Assessment (测评)
  assessmentResults AssessmentResult[]

  // Recommendation Letters (推荐信)
  recommendationLetters RecommendationLetter[]

  // Vault (密码保险库)
  vaultItems VaultItem[]

  // MCP API Keys
  mcpApiKeys McpApiKey[]

  // Recommendations (选校推荐)
  schoolRecommendations  SchoolRecommendation[]
  schoolCommunityRatings SchoolCommunityRating[]
  predictionFeedback     PredictionFeedback[]

  // Case views (案例查看记录)
  caseViews CaseView[]

  // Application timeline
  applicationTimelines ApplicationTimeline[]
  personalEvents       PersonalEvent[]

  // Resume
  resumes Resume[]

  // Verification
  verificationRequests VerificationRequest[]

  // Permissions (per-user overrides)
  userPermissions UserPermission[]

  // Referral system
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  // Ban system
  isBanned    Boolean   @default(false)
  bannedAt    DateTime?
  bannedUntil DateTime? // null = permanent ban
  banReason   String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  lastLoginAt DateTime?

  @@index([email])
  @@index([deletedAt])
  @@index([isBanned])
  @@index([deletedAt, isBanned])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model McpApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  keyPrefix  String    @db.VarChar(12) // "mcp_" + first 8 hex chars for lookup
  name       String    @db.VarChar(100) // e.g., "Claude Desktop", "Cursor IDE"
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyPrefix])
  @@map("mcp_api_keys")
}

// ============================================
// Profile & Related
// ============================================

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public profile
  nickname  String? // 显示昵称
  avatarUrl String? // 头像 URL
  bio       String? @db.Text // 个人简介

  // Strong Sensitive - Never public
  realName String?

  // Onboarding fields
  birthday            DateTime?
  graduationDate      DateTime?
  onboardingCompleted Boolean   @default(false)

  // Sensitive - Optional anonymized
  gpa               Decimal? @db.Decimal(5, 2)
  gpaScale          Decimal  @default(4.0) @db.Decimal(5, 2)
  gpa9              Decimal? @db.Decimal(5, 2)
  gpa10             Decimal? @db.Decimal(5, 2)
  gpa11             Decimal? @db.Decimal(5, 2)
  gpa12             Decimal? @db.Decimal(5, 2)
  currentSchool     String?
  currentSchoolType String? // PUBLIC_US / PRIVATE_US / INTERNATIONAL / etc.
  grade             String? // FRESHMAN / SOPHOMORE / JUNIOR / SENIOR / GAP_YEAR

  // Non-sensitive
  targetMajor      String?
  intendedMajor    String?
  secondMajor      String?
  regionPref       String[]
  budgetTier       BudgetTier?
  applicationRound String? // ED / EA / RD

  // Demographics & context
  nationality        String?
  countryOfResidence String?
  citizenship        String?
  legacy             String[]         @default([])
  firstGeneration    Boolean          @default(false)
  needsFinancialAid  Boolean?
  educationSystem    EducationSystem?

  // Counselor-engine modifier inputs (PR-1, opt-in, additive migration).
  // Both default to "no effect" so existing profiles aren't impacted by the
  // counselor-mode rollout. Surfaced via profile settings UI when users
  // self-identify (athletes for recruitment, demographic for URM context).
  recruitedAthlete Boolean? @default(false)
  // 'PREFER_NOT_SAY' | 'BLACK' | 'HISPANIC' | 'NATIVE_AMERICAN' | 'PACIFIC_ISLANDER' | null
  // Stored as free-text string (not enum) because:
  //   1. Categories may evolve as US Census revises (NACAC tracks 2030 reform)
  //   2. Some users prefer multi-select; deferring to comma-separated string future-proofs
  // Counselor's urmMultiplier reads only the canonical 4 values above.
  urmStatus        String?

  // PR-14 (4/27): test-optional applicants. Common App data shows top-30
  // private schools admit test-optional applicants 5-10pp lower than
  // test-submitters; counselor applies a 0.85× modifier at <20% admit
  // schools when this flag is true. Defaults false (legacy behavior).
  // Different from "no test scores in profile" — this is an EXPLICIT
  // declaration "I'm applying test-optional" vs "I haven't filled in yet".
  applyingTestOptional Boolean? @default(false)

  // Recommendation preferences (JSON)
  recommendationPreferences Json?

  // Visibility
  visibility Visibility @default(PRIVATE)

  // Relations
  testScores              TestScore[]
  activities              Activity[]
  awards                  Award[]
  education               Education[]
  essays                  Essay[]
  predictions             PredictionResult[]
  sourceObservations      PredictionSourceObservation[]
  semesterGpas            SemesterGpa[]
  applicationAnalysisRuns ApplicationAnalysisRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([visibility])
  @@index([onboardingCompleted])
}

model SemesterGpa {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  semester String // e.g. "Fall 2024", "Spring 2025", "Grade 9", "Grade 10"
  year     Int // academic year, e.g. 2024
  gpa      Decimal  @db.Decimal(5, 2)
  gpaScale Decimal  @default(4.0) @db.Decimal(5, 2)
  credits  Decimal? @db.Decimal(5, 1) // optional: credit hours for weighted avg
  order    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, semester, year])
  @@index([profileId])
}

model TestScore {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type      TestType
  score     Int
  subject   String?
  subScores Json? // { reading: 800, math: 800 } or { listening: 30, reading: 29 }
  testDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model Activity {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name                 String
  category             ActivityCategory
  role                 String
  organization         String?
  description          String?           @db.Text
  commonAppDescription String?           @db.VarChar(150)
  startDate            DateTime?
  endDate              DateTime?
  hoursPerWeek         Int?
  weeksPerYear         Int?
  isOngoing            Boolean           @default(false)
  order                Int               @default(0)
  gradeLevels          Int[]             @default([])
  timing               ActivityTiming?
  activityTemplateId   String?
  activityTemplate     ActivityTemplate? @relation(fields: [activityTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([activityTemplateId])
}

model ActivityTemplate {
  id          String           @id @default(cuid())
  name        String           @unique
  nameZh      String?
  aliases     String[]         @default([])
  category    ActivityCategory
  tier        Int              @default(4)
  description String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  activities  Activity[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tier])
  @@index([category])
}

model Award {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String
  level       AwardLevel
  category    AwardCategory?
  year        Int?
  description String?
  order       Int            @default(0)

  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([competitionId])
  @@index([category])
}

// ============================================
// Competition Reference Data
// ============================================

model Competition {
  id            String              @id @default(cuid())
  name          String // Full English name
  abbreviation  String              @unique // e.g., "AMC 10", "USABO"
  nameZh        String? // Chinese name
  category      CompetitionCategory
  level         AwardLevel // SCHOOL / REGIONAL / STATE / NATIONAL / INTERNATIONAL
  tier          Int // 1-5 prestige (5 = highest, e.g. IMO Gold)
  description   String?             @db.Text
  descriptionZh String?             @db.Text
  website       String?
  isActive      Boolean             @default(true)

  awards           Award[]
  editions         CompetitionEdition[]
  matchPoolEntries MatchPoolEntry[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([category])
  @@index([tier])
}

model CompetitionEdition {
  id                  String                   @id @default(cuid())
  competitionId       String
  competition         Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonLabel         String
  status              CompetitionEditionStatus @default(ACTIVE)
  registrationOpenAt  DateTime?
  registrationCloseAt DateTime?
  eventStartAt        DateTime?
  eventEndAt          DateTime?
  tracks              CompetitionTrack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, seasonLabel])
  @@index([status])
}

model CompetitionTrack {
  id                   String              @id @default(cuid())
  competitionEditionId String
  competitionEdition   CompetitionEdition  @relation(fields: [competitionEditionId], references: [id], onDelete: Cascade)
  name                 String
  rolePresets          String[]
  minTeamSize          Int
  maxTeamSize          Int
  languages            String[]
  isActive             Boolean             @default(true)
  recruitmentContext   RecruitmentContext?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionEditionId, name])
  @@index([isActive])
}

model MatchPool {
  id          String  @id @default(cuid())
  name        String
  nameZh      String?
  description String? @db.Text
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  entries MatchPoolEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model MatchPoolEntry {
  id                   String              @id @default(cuid())
  matchPoolId          String
  matchPool            MatchPool           @relation(fields: [matchPoolId], references: [id], onDelete: Cascade)
  entryType            MatchPoolEntryType
  competitionId        String?
  competition          Competition?        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  recruitmentContextId String?
  recruitmentContext   RecruitmentContext? @relation(fields: [recruitmentContextId], references: [id], onDelete: Cascade)
  sortOrder            Int                 @default(0)
  isActive             Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchPoolId, isActive, sortOrder])
  @@index([competitionId])
  @@index([recruitmentContextId])
}

model RecruitmentContext {
  id                  String                             @id @default(cuid())
  sourceType          RecruitmentContextSourceType
  title               String
  titleZh             String?
  subtitle            String?
  description         String?                            @db.Text
  sourceUrl           String?
  registrationCloseAt DateTime?
  eventStartAt        DateTime?
  eventEndAt          DateTime?
  locationMode        LocationMode?
  locationText        String?
  rolePresets         String[]
  minTeamSize         Int
  maxTeamSize         Int
  languages           String[]
  moderationStatus    RecruitmentContextModerationStatus @default(PENDING_REVIEW)
  isPublished         Boolean                            @default(false)
  publishedAt         DateTime?
  isActive            Boolean                            @default(true)
  createdById         String?
  createdBy           User?                              @relation("CommunityRecruitmentContextCreator", fields: [createdById], references: [id], onDelete: SetNull)
  competitionTrackId  String?                            @unique
  competitionTrack    CompetitionTrack?                  @relation(fields: [competitionTrackId], references: [id], onDelete: Cascade)

  matchPoolEntries MatchPoolEntry[]
  recruitmentCards TeamRecruitmentCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceType, isPublished, isActive])
  @@index([createdById, updatedAt])
  @@index([moderationStatus, updatedAt])
}

model Education {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  schoolName   String
  schoolType   String? // HIGH_SCHOOL / COLLEGE / etc.
  degree       String?
  major        String?
  startDate    DateTime?
  endDate      DateTime?
  gpa          Decimal?    @db.Decimal(3, 2)
  gpaScale     Decimal?    @db.Decimal(3, 2)
  description  String?
  highSchoolId String?
  highSchool   HighSchool? @relation(fields: [highSchoolId], references: [id], onDelete: SetNull)
  gpaSystem    String? // "SCALE_4_UW" | "SCALE_4_W" | "SCALE_5" | "PCT_100" | "IB_45" | "A_LEVEL"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([highSchoolId])
}

// ============================================
// High School Reference Data
// ============================================

model HighSchool {
  id           String         @id @default(cuid())
  name         String
  nameZh       String?
  abbreviation String?        @unique
  country      String
  state        String?
  city         String?
  type         HighSchoolType
  tier         Int // 1-5 (5 = top feeder, computed from evaluation dimensions)
  description  String?        @db.Text
  isActive     Boolean        @default(true)

  // === Standardized Evaluation Dimensions (1-5) ===
  recognition     Int? // AO 认可度: AO familiarity with this school
  academicRigor   Int? // 学术严格度: course difficulty, grade deflation
  placementRecord Int? // 升学表现: historical placement at top universities
  studentQuality  Int? // 生源质量: student body competitiveness
  resources       Int? // 资源与支持: counseling, alumni network, AO relationships

  // === Evaluation Metadata ===
  evaluatedAt     DateTime? // Last evaluation timestamp
  evaluatedBy     String? // Evaluator: admin userId or "system" or "ai-draft"
  evaluationNotes String?   @db.Text // Evaluation notes / justification

  // === Supplementary Data ===
  avgSatScore      Int? // Average SAT of graduates
  avgIbScore       Int? // Average IB score (if applicable)
  annualTop30Count Int? // Estimated annual admits to US Top 30
  annualApplicants Int? // Estimated annual US college applicants
  gradeInflation   String? // "deflation" | "neutral" | "inflation"
  website          String? // Official website URL

  // === Quality Gate (Layer 1) ===
  qualityScore    Int? // 0-100, computed by computeHsQualityScore()
  qualityGrade    String? // A/B/C/D — determines routing
  hsImpactEnabled Boolean @default(true) // D-grade schools do not participate in prediction scoring

  educations          Education[]
  cases               AdmissionCase[]
  sourceObservations  PredictionSourceObservation[]
  relationshipSignals SchoolRelationshipSignal[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([name, country, state])
  @@index([country])
  @@index([tier])
  @@index([type])
}

model HighSchoolSuggestion {
  id          String   @id @default(cuid())
  name        String
  country     String
  state       String?
  city        String?
  submittedBy String[] // userIds who suggested this school
  status      String   @default("pending") // pending | approved | rejected | merged
  mergedInto  String? // highSchoolId if merged into existing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, country])
  @@index([status])
}

model Essay {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title     String
  prompt    String? @db.Text
  content   String  @db.Text
  wordCount Int?
  schoolId  String? // Optional: linked to specific school

  // Link to verified essay prompt from database
  essayPromptId String?
  linkedPrompt  EssayPrompt? @relation(fields: [essayPromptId], references: [id], onDelete: SetNull)

  // AI results
  aiResults   EssayAIResult[]
  revisions   EssayRevision[]
  suggestions EssaySuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([essayPromptId])
}

model EssayRevision {
  id      String @id @default(cuid())
  essayId String
  essay   Essay  @relation(fields: [essayId], references: [id], onDelete: Cascade)

  title     String
  prompt    String? @db.Text
  content   String  @db.Text
  wordCount Int
  reason    String?
  source    String  @default("manual") // manual | autosave | ai_apply | restore

  suggestions EssaySuggestion[] @relation("SuggestionSourceRevision")

  createdAt DateTime @default(now())

  @@index([essayId])
  @@index([createdAt])
}

model EssaySuggestion {
  id      String @id @default(cuid())
  essayId String
  essay   Essay  @relation(fields: [essayId], references: [id], onDelete: Cascade)

  kind            String  @default("rewrite") // rewrite | shorten | clarity | opening | continuation
  originalText    String? @db.Text
  replacementText String  @db.Text
  reason          String  @db.Text
  impact          String? @db.Text
  status          String  @default("PENDING") // PENDING | APPLIED | REJECTED
  insertMode      String  @default("replace") // replace | append | prepend

  createdFromRevisionId String?
  createdFromRevision   EssayRevision? @relation("SuggestionSourceRevision", fields: [createdFromRevisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([essayId])
  @@index([status])
  @@index([createdFromRevisionId])
}

// ============================================
// School Data
// ============================================

model School {
  id       String  @id @default(cuid())
  name     String
  nameNorm String  @unique // LOWER(TRIM(name)), maintained by DB trigger
  nameZh   String?
  country  String  @default("US")
  state    String?
  city     String?

  // External IDs (promoted from metadata JSON for indexing)
  scorecardId String? @unique // College Scorecard ID
  ipedsId     String? @unique // IPEDS UNITID

  // Rankings & Metrics
  usNewsRank      Int?
  qsRank          Int?
  acceptanceRate  Decimal? @db.Decimal(5, 2)
  tuition         Int? // Annual tuition in USD
  avgSalary       Int? // Average salary after graduation
  totalEnrollment Int?

  // Test Score Statistics (from College Scorecard)
  satAvg         Int? // SAT total average
  sat25          Int? // SAT 25th percentile (math + reading combined)
  sat75          Int? // SAT 75th percentile (math + reading combined)
  satMath25      Int? // SAT Math 25th percentile
  satMath75      Int? // SAT Math 75th percentile
  satReading25   Int? // SAT ERW 25th percentile
  satReading75   Int? // SAT ERW 75th percentile
  actAvg         Int? // ACT composite average/midpoint
  act25          Int? // ACT composite 25th percentile
  act75          Int? // ACT composite 75th percentile
  studentCount   Int? // Total student enrollment (from College Scorecard)
  graduationRate Decimal? @db.Decimal(5, 2) // 4-year graduation rate %

  // School Type
  isPrivate       Boolean          @default(false)
  institutionType InstitutionType?

  // International student info
  needBlindInternational Boolean  @default(false)
  intlStudentPct         Decimal? @db.Decimal(5, 2)
  intlAcceptanceRate     Decimal? @db.Decimal(5, 2)
  oosAcceptanceRate      Decimal? @db.Decimal(5, 2) // Out-of-state freshman admit rate %

  // Transfer student info
  transferAcceptanceRate Decimal? @db.Decimal(5, 2) // Transfer admission rate %

  // Early-round admit rates (from CDS C21 / institutional ED reports)
  // Used by counselor roundMultiplier to scale ED/EA boost per school selectivity
  edAcceptanceRate Decimal? @db.Decimal(5, 2) // Early Decision admit rate %
  eaAcceptanceRate Decimal? @db.Decimal(5, 2) // Early Action / REA admit rate %

  // School-specific enrolled freshman GPA distribution (from CDS C9)
  // Shape: { "3.75-4.00": 0.91, "3.50-3.74": 0.07, "3.25-3.49": 0.02, "3.00-3.24": 0, "<3.00": 0 }
  // Used by gpaBandMultiplier to compute applicant's percentile within this school's class
  gpaDistribution Json?

  // Niche Grades (A+, A, A-, B+, B, B-, C+, C, C-, D+, D, D-, F)
  nicheSafetyGrade  String? // Safety/Crime index
  nicheLifeGrade    String? // Student Life/Happiness index
  nicheFoodGrade    String? // Campus Food index
  nicheOverallGrade String? // Overall Niche grade

  // Retention & Academics (from BigFuture)
  retentionRate       Decimal? @db.Decimal(5, 2) // First-year retention rate %
  studentFacultyRatio Int? // e.g. 6 means 6:1

  // Financial Aid (from BigFuture + Appily)
  percentNeedMet    Decimal? @db.Decimal(5, 2) // % of demonstrated need met
  averageAidPackage Int? // Average financial aid package in USD
  averageNetPrice   Int? // Net price after aid in USD
  roomAndBoard      Int? // Annual room & board cost in USD

  // Application Info (from BigFuture + IPEDS)
  applicationFee     Int? // Application fee in USD
  feeWaiverAvailable Boolean? // null=unknown, false=no, true=yes
  acceptsCommonApp   Boolean? // null=unknown, false=no, true=yes
  acceptsCoalition   Boolean?
  testOptional       Boolean?
  testingPolicy      TestingPolicy @default(UNKNOWN)
  hasEarlyDecision   Boolean?

  // Post-Graduation Outcomes (from Appily)
  salary6YrPostGrad  Int? // Median salary 6 years after graduation
  loanDefaultRate    Decimal? @db.Decimal(5, 2) // Federal loan default rate %
  monthlyLoanPayment Int? // Median monthly loan payment

  // Campus Life (from Appily)
  countriesRepresented  Int? // Number of countries represented
  studentOrgsCount      Int? // Number of student organizations
  housingAvailable      Boolean? // Whether on-campus housing is available
  housingRequiredYears  Int? // Number of years students are required to live on campus
  percentLivingOnCampus Decimal? @db.Decimal(5, 2) // Percent of students living on campus
  mealPlanCost          Int? // Annual meal plan cost in USD
  campusSafetyServices  String[] @default([]) // Source-backed campus safety services
  campusLifeSummary     Json? // Source-backed campus-life summary facts

  // Search aliases (abbreviations, short names, nicknames)
  aliases String[] @default([]) // e.g. ["MIT", "麻省理工", "Mass Tech"]

  // Data enrichment — review tracking
  lastDataReviewAt DateTime?
  dataReviewStatus DataReviewStatus @default(AUTO_APPROVED)

  // Additional Info
  website       String?
  logoUrl       String?
  description   String? @db.Text
  descriptionZh String? @db.Text
  metadata      Json? // { deadlines, essayPrompts, requirements, lastScraped }

  // Relations
  metrics                           SchoolMetric[]
  historicalData                    SchoolHistoricalData[]
  cdsAdmitBands                     SchoolCdsAdmitBand[]
  programs                          SchoolProgram[]
  cases                             AdmissionCase[]
  targetedBy                        ProfileTargetSchool[]
  schoolLists                       SchoolListItem[]
  essayPrompts                      EssayPrompt[]
  essaySources                      SchoolEssaySource[]
  deadlines                         SchoolDeadline[]
  timelines                         ApplicationTimeline[]
  teams                             Team[]
  calibration                       SchoolCalibration?
  rankings                          SchoolRanking[]
  sourceObservations                PredictionSourceObservation[]
  cohortRoundPriors                 SchoolCohortRoundPrior[]
  cohortRegimeSignals               SchoolCohortRegimeSignal[]
  relationshipSignals               SchoolRelationshipSignal[]
  communityRatings                  SchoolCommunityRating[]
  mediaAssets                       SchoolMediaAsset[]
  policyEvidence                    SchoolPolicyEvidence[]
  competitorPredictions             CompetitorPrediction[]
  staticTeacherSnapshots            StaticTeacherSnapshot[]
  distillationSchoolDailyAggregates DistillationSchoolDailyAggregate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([nameZh])
  @@index([usNewsRank])
  @@index([isPrivate])
  @@index([testOptional])
  @@index([testingPolicy])
  @@index([hasEarlyDecision])
  @@index([country, usNewsRank])
}

// Multi-source ranking: one school can appear in multiple ranking lists
model SchoolRanking {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  source    String // "US_NEWS", "QS", "NICHE", "FORBES", "THE"
  list      String // "NATIONAL_UNIVERSITY", "LIBERAL_ARTS", "ENGINEERING_NO_PHD", "ART_DESIGN", "CS", "BUSINESS"
  rank      Int
  year      Int
  sourceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, source, list, year])
  @@index([source, list, year, rank])
}

model SchoolMetric {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  year      Int
  metricKey String // acceptance_rate, avg_sat, avg_gpa, etc.
  value     Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, year, metricKey])
  @@index([schoolId])
}

/// Stores five-year scalar history without overwriting the latest service value
/// on School. Generic by design (covers many display + prediction fields from the
/// data marathon).
model SchoolHistoricalData {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  field      String
  year       Int
  value      Json
  source     String
  confidence String  @default("LOW")
  staleness  String
  sourceUrl  String?
  notes      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, field, year, source])
  @@index([schoolId, field, year])
  @@index([field, year])
}

model SchoolCdsAdmitBand {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  gpaBand   String
  testType  String
  testBand  String
  admitRate Decimal @db.Decimal(6, 4)

  sampleCount Int?
  cycleYear   Int
  source      String
  sourceUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, gpaBand, testType, testBand, cycleYear])
  @@index([schoolId, gpaBand, testType, testBand])
}

model SchoolCommunityRating {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  safetyRating Int
  lifeRating   Int
  foodRating   Int

  isHidden     Boolean   @default(false)
