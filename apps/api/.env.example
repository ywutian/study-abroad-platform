# ===================================================
# Study Abroad Platform — API Environment Variables
# ===================================================
# Copy to .env and fill in the required values.
# See apps/api/src/common/config/env.validation.ts for Zod schema.

# --- Core ---
NODE_ENV=development
PORT=4101
# LOG_LEVEL=log  # verbose | debug | log | warn | error

# --- Database (REQUIRED) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_abroad?schema=public"

# --- JWT (REQUIRED) ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Redis (Optional — falls back to in-memory) ---
REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_COMMAND_TIMEOUT_MS=5000

# --- CORS (REQUIRED in production) ---
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# --- Email Verification ---
SKIP_EMAIL_VERIFICATION=true

# --- Email (Optional) ---
# RESEND_API_KEY=re_xxxx
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@example.com"
EMAIL_FROM_NAME="留学申请平台"

# --- Frontend URL (REQUIRED in production, used in email links) ---
FRONTEND_URL="http://localhost:4100"

# --- AI / LLM (Optional) ---
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# LLM_PROVIDER=openai         # openai | anthropic
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_ROUTER_MODE=shadow  # shadow (log only) | active (route decisions)

# --- Search Engines (Optional) ---
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# TAVILY_API_KEY=

# --- Memory & Cache ---
# MEMORY_CACHE_TTL=86400

# --- Observability ---
# APP_NAME=api
# METRICS_ENABLED=true

# --- OpenTelemetry (Optional — distributed tracing + metrics) ---
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable. Local Jaeger: http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=study-abroad-api

# --- College Scorecard (Optional) ---
# COLLEGE_SCORECARD_API_KEY=

# --- Logo.dev (Optional — auto-fill school logos) ---
# LOGO_DEV_TOKEN=

# --- Storage ---
STORAGE_TYPE=local
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Vault Encryption (REQUIRED in production) ---
# Generate with: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=

# --- Sentry (Optional, recommended in production) ---
# SENTRY_DSN=https://xxx@sentry.io/xxx

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Webhook Signature (REQUIRED in production, min 32 chars) ---
WEBHOOK_SECRET=

# --- Request Timeouts (ms) ---
# REQUEST_TIMEOUT_MS=30000
# AUTH_REQUEST_TIMEOUT_MS=60000
# AI_REQUEST_TIMEOUT_MS=120000

# --- Prisma ---
# PRISMA_SLOW_QUERY_MS=200

# --- Build Metadata (auto-set in CI) ---
# GIT_COMMIT_SHA=
# BUILD_TIME=
