# ===================================================
# Study Abroad Platform — API Environment Variables
# ===================================================
# Copy to .env and fill in the required values.
# See apps/api/src/common/config/env.validation.ts for Zod schema.

# --- Core ---
NODE_ENV=development
PORT=4101
# LOG_LEVEL=log  # verbose | debug | log | warn | error

# --- Database (REQUIRED) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_abroad?schema=public"

# --- JWT (REQUIRED) ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Redis (Optional — falls back to in-memory) ---
REDIS_URL="redis://localhost:6379"
# REDIS_CACHE_URLS="redis://cache-primary:6379,redis://cache-backup:6379"
# REDIS_STATE_URLS="redis://state-primary:6379,redis://state-backup:6379"
# REDIS_URLS="redis://primary:6379,redis://backup:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_COMMAND_TIMEOUT_MS=1000
# REDIS_CIRCUIT_BREAKER_COOLDOWN_MS=3600000
# REDIS_HEALTH_PING_INTERVAL_MS=60000
# REDIS_MAX_RETRIES_PER_REQUEST=1
# REDIS_ENABLE_OFFLINE_QUEUE=false

# --- Scheduler governance ---
SCHEDULERS_ENABLED=true
APPLICATION_ANALYSIS_AUTOMATION_ENABLED=true
# timer (default) = @Cron fires in-process (dev/tests/docker).
# http = no in-process timers; Cloud Scheduler POSTs /internal/cron/:name/run
#        (production — see common/cron/schedule-driver.ts for why).
# CRON_DRIVER=timer
# Required (>=32 chars) when CRON_DRIVER=http; also enables manually driving
# /internal/cron locally. Generate: openssl rand -hex 32
# CRON_SECRET=
# Cron dead-man's-switch: when set, each @Cron pings <base>/<slug> on success
# (slugs: deadline-reminder, outcome-reminder, ipeds-monitor, deadline-refresh).
# Unset = heartbeats disabled. See docs/MONITORING.md (Layer 4).

# --- CORS (REQUIRED in production) ---
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# --- Email Verification ---
SKIP_EMAIL_VERIFICATION=true

# --- Email (Optional — Resend transactional email) ---
# In production, verify lumniedu.com in Resend before sending to real users.
RESEND_API_KEY=""
EMAIL_FROM="noreply@lumniedu.com"
EMAIL_FROM_NAME="Lumni"
# Legacy SMTP_* variables are validated for compatibility but are not used by EmailService.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"

# --- Frontend URL (REQUIRED in production, used in email links) ---
FRONTEND_URL="http://localhost:4100"
# Production receives only a base64-encoded bcrypt hash. Never commit it.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD_HASH_B64=

# --- AI / LLM (Optional) ---
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional isolated chat config; key/base/model are required together.
# OPENAI_CHAT_API_KEY must come from a managed secret, never commit a value.
# OPENAI_CHAT_BASE_URL="https://your-approved-chat-provider.example/v1"
# OPENAI_CHAT_MODEL="gpt-5.4"
# OPENAI_CHAT_TRANSPORT="sse"
# OPENAI_CHAT_REASONING_EFFORT="none"
# When set, OPENAI_API_KEY / OPENAI_BASE_URL still serve embeddings/moderation.
# To route LLM spend through the agent-spend-collector gateway (per-call ledger +
# anomaly detection, no code change — baseUrl is read from OPENAI_BASE_URL):
#   OPENAI_BASE_URL="http://<gateway-host>:8787/openai/v1"
#   OPENAI_API_KEY="<gateway-token>"   # real sk-... key lives only on the gateway
# LLM_PROVIDER=openai         # OpenAI-compatible providers only
AI_AGENT_HARNESS_V1=false
AI_AGENT_APPROVALS_V1=false
AI_AGENT_CONTEXT_V1=false
AI_AGENT_ACCEPTANCE_V1=false
AI_AGENT_SKILLS_V1=false
AI_AGENT_SKILLS_EVOLUTION_V1=false
AI_AGENT_SKILLS_AUTO_PUBLISH_V1=false
AI_AGENT_MAX_TOKENS_PER_RUN=24000
AI_AGENT_MAX_DURATION_MS=120000
AI_AGENT_CONTEXT_RECENT_MESSAGES=10
AI_AGENT_RUN_RETENTION_DAYS=90
AI_AGENT_TRACE_RETENTION_DAYS=30
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_ROUTER_MODE=shadow  # shadow (log only) | active (route decisions)

# --- Search Engines (Optional) ---
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# TAVILY_API_KEY=

# --- Memory & Cache ---
# MEMORY_CACHE_TTL=86400

# --- Observability ---
# APP_NAME=api
# METRICS_ENABLED=true

# --- OpenTelemetry (Optional — distributed tracing + metrics) ---
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable. Local Jaeger: http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=study-abroad-api

# --- College Scorecard (Optional) ---
# COLLEGE_SCORECARD_API_KEY=

# --- Logo.dev (Optional — auto-fill school logos) ---
# LOGO_DEV_TOKEN=

# --- Storage ---
STORAGE_TYPE=local
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Vault Encryption (REQUIRED in production) ---
# Generate with: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=

# --- Sentry (Optional, recommended in production) ---
# SENTRY_DSN=https://xxx@sentry.io/xxx

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Payments (RETIRED; all product features are open) ---
# Keep both values unchanged in every production environment. `simulator` is
# reserved for explicit local/test fixtures and can never run in production.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=none
# Legacy generic webhook secret; unused while payments are retired.
WEBHOOK_SECRET=

# --- Request Timeouts (ms) ---
# REQUEST_TIMEOUT_MS=30000
# AUTH_REQUEST_TIMEOUT_MS=60000
# AI_REQUEST_TIMEOUT_MS=120000

# --- Prisma ---
# PRISMA_SLOW_QUERY_MS=200

# --- Build Metadata (auto-set in CI) ---
# GIT_COMMIT_SHA=
# BUILD_TIME=
