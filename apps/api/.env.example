# Database
DATABASE_URL="postgresql://user:password@localhost:5432/study_abroad?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis (optional, falls back to in-memory cache)
REDIS_URL="redis://localhost:6379"
# 多项目本地开发时，可改为 6381 避免与其他项目冲突：
# REDIS_URL="redis://localhost:6381"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_COMMAND_TIMEOUT_MS=5000  # per-command timeout (default 5000)

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@example.com"
EMAIL_FROM_NAME="留学申请平台"

# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:4100"

# Server
PORT=4101
NODE_ENV=development
# REQUEST_TIMEOUT_MS=30000         # global request timeout (default 30s)
# AUTH_REQUEST_TIMEOUT_MS=60000    # login/refresh timeout (default 60s)
# AI_REQUEST_TIMEOUT_MS=120000     # AI stream timeout (default 120s)
# PRISMA_SLOW_QUERY_MS=200         # slow query log threshold (default 200ms)

# Logging
# LOG_LEVEL=log  # verbose | debug | log | warn | error

# Storage (local | s3 | gcs)
STORAGE_TYPE=local
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# College Scorecard API (optional, for school data)
# COLLEGE_SCORECARD_API_KEY=

# Sentry (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Required in production. Generate: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=

# Required in production for payment webhook verification
WEBHOOK_SECRET=

# Required in production. Comma-separated. Example: https://app.example.com
CORS_ORIGINS=
