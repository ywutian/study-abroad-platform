{
  "name": "@study-abroad/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "require": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts",
      "require": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    },
    "./design": {
      "types": "./src/design/index.ts",
      "import": "./src/design/index.ts",
      "require": "./dist/design/index.js",
      "default": "./dist/design/index.js"
    },
    "./design/theme-contract": {
      "types": "./src/design/theme-contract.ts",
      "import": "./src/design/theme-contract.ts",
      "require": "./dist/design/theme-contract.js",
      "default": "./dist/design/theme-contract.js"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./scoring": {
      "types": "./src/scoring/index.ts",
      "import": "./src/scoring/index.ts",
      "require": "./dist/scoring/index.js",
      "default": "./dist/scoring/index.js"
    },
    "./ranking": {
      "types": "./src/ranking/index.ts",
      "import": "./src/ranking/index.ts",
      "require": "./dist/ranking/index.js",
      "default": "./dist/ranking/index.js"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts",
      "require": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
