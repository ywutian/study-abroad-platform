# Claude Code — most config is per-developer, but the agent / rule / skill
# playbooks and the workflow manifest are project conventions that must travel
# with the repo: CLAUDE.md documents them as mandatory, and `lint:drift`
# validates CLAUDE.md against them — it can only do that if a fresh checkout
# actually has them. Ignore everything else under .claude/.
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/manifests/
!.claude/manifests/**
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**

.vercel
.env*.local
apps/api/.env.backup
apps/api/.secrets/

# SBOM (generated, stored as CI artifact)
sbom/

# Database backups
backups/

# Full-platform verification reports (generated by scripts/verify-full-platform.ts)
verification-report/

# Layer 3 calibration spec run reports (generated by run-counselor-calibration-spec.ts)
apps/api/gold-cases/counselor-calibration/reports/

# Application-analysis gold replay reports (generated on demand by gold replay runs).
# Per gold-cases/README.md these are "created on demand, not committed".
apps/api/gold-cases/reports/

# Per-applicant training-data features (generated by learn-prediction-coefficients.ts --dump).
# Contains gpa/sat/hooks/outcome for individual AdmissionCase rows — anonymized
# (caseId only, no userId, no name) but kept out of git as a safety belt.
apps/api/scripts/training-data/

# Externally-gathered admit cases (forum / social self-reports). Raw agent
# dumps stay OUT of git for ToS / provenance reasons — only the merge script
# is committed; re-run it locally to regenerate the corpus.
apps/api/scripts/external-cases-raw/*
!apps/api/scripts/external-cases-raw/.gitkeep

# Externally-gathered forum capture pilots (screenshots + structured dumps).
# Same ToS / provenance policy as external-cases-raw: kept OUT of git.
apps/api/scripts/onepoint3acres-authorized-captures/

# Closure-cycle run reports — timestamped JSON/CSV/MD/SQL artifacts written by
# the *-packet.ts scripts + admin-profile-readiness-delivery.service.ts. These
# are generated OUTPUT (1634 files, ~1.86M lines), not source — they bloated the
# repo and skewed every churn metric. Untracked in #461 follow-up; regenerate on
# demand. (Historical blobs still live in .git; shrink with git-filter-repo if needed.)
apps/api/scripts/closure-reports/

# Generated outputs (large binary/asset dumps, not source)
outputs/

gcp-sa-key.json

# Generated git-history dashboard (pnpm git:dashboard)
git-dashboard.html
